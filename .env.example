# ---- Server ----
PORT=8080
BASE_URL=https://wa.yourdomain.in          # public URL of this service (magic links and payment pages use it)
APP_SECRET=change-me-long-random-string
ADMIN_KEY=change-me-admin-key              # sent as x-api-key for /admin/* routes

# ---- Database ----
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=wa_engine
SEED_SAMPLE=false                          # true loads sample questions/tests once (for a demo)

# ---- WhatsApp (Cloud API format) ----
WA_API_BASE=https://graph.facebook.com/v21.0   # or your BSP's Cloud-API-compatible base URL
WA_TOKEN=                                       # permanent access token
WA_VERIFY_TOKEN=pick-any-string                 # same value goes in the webhook setup screen
WA_APP_SECRET=                                  # Meta app secret; enables signature checks
# Raise Academy runs all three products on ONE verified number: +91 94434 24064
WA_PHONE_ID_SHARED=                             # the Phone number ID (a long number from Meta/BSP), NOT 9443424064
WA_DISPLAY_SHARED=919443424064                  # used for wa.me share links
WA_BUSINESS_NAME=Raise Academy
# Optional later: separate numbers per product (then leave WA_PHONE_ID_SHARED empty)
WA_PHONE_ID_YNEET=
WA_PHONE_ID_TESTMANDI=
WA_PHONE_ID_CLASSCOACH=

# ---- AiSensy (optional) ----
# The AiSensy API key only sends approved templates via "API campaigns". It cannot run the two-way bot.
# Set it to send the TEMPLATE_* messages below through AiSensy; use AiSensy campaign NAMES as their values.
AISENSY_API_KEY=

# ---- Payments (Razorpay Payment Links) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- TestMandi catalogue sync ----
TESTMANDI_SYNC=false            # true: copy tests from testmandi.in every 15 min and record WhatsApp sales there
TESTMANDI_DB=testmandi          # TestMandi's database name on the same MongoDB cluster
TESTMANDI_SYNC_MINUTES=15

# ---- Link to app.yneet.in (optional) ----
# YNeet's PostgreSQL connection string (same as DATABASE_URL in the YNeet backend). When set, a WhatsApp
# purchase unlocks the student's app.yneet.in account (matched by phone), and web subscribers get full
# access on WhatsApp too. YNeet's referral rule (free month) runs in both places.
YNEET_DATABASE_URL=
YNEET_DB_SSL=true

# ---- Offers and dates ----
OFFER_ENDS_ON=                 # e.g. 2026-11-30 shows "Offer price till 30 Nov". Leave empty for no offer.
NEET_DATE=2027-05-02           # season pass end date; update when NTA announces the exam date

# ---- Approved message templates (only needed outside the 24-hour window) ----
TEMPLATE_DAILY_QUIZ=
TEMPLATE_PARENT_REPORT=
TEMPLATE_SELLER_SALE=
TEMPLATE_CLASS_QUIZ=
TEMPLATE_CLASS_RESULTS=
TEMPLATE_UPGRADE=
TEMPLATE_TRIAL_ENDING=

ENABLE_CRON=true

# ---- Lead engine (/admin/leads?key=ADMIN_KEY) ----
OWNER_PHONES=                 # your personal mobile(s) for hot-lead alerts, comma separated (NOT 9443424064)
OWNER_NAME=Akbar              # name used in "Akbar will message you" replies
LEAD_TEAM=Akbar,Assistant     # names in the "Assign" dropdown
LEAD_MAX_STOP_PCT=5           # auto-pause when more than this % tap Stop in a week
HUMAN_PAUSE_HOURS=12          # bot stays quiet this long after you reply from the WhatsApp Business app
LEAD_TPL_LANG=en
# Template names (create these in WhatsApp Manager with exactly these names, or change here)
LEAD_TPL_TUTOR=ra_lead_tutor
LEAD_TPL_SCHOOL=ra_lead_school
LEAD_TPL_INSTITUTE=ra_lead_institute
LEAD_TPL_NEET=ra_lead_neet
LEAD_TPL_STUDENT=ra_lead_student
LEAD_TPL_FOLLOWUP=ra_lead_followup
LEAD_TPL_FINAL=ra_lead_final
TEMPLATE_OWNER_ALERT=         # optional utility template with one {{1}} for alerts when you haven't messaged the bot in 24h
TEMPLATE_ONBOARD_CHECKIN=     # optional template ({{1}} name, {{2}} product) for onboarding outside the 24h window
